<!DOCTYPE html>
<html lang="de" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Store Control – Zentraler Umsatz- & Kostenmanager</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                        },
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="styles.css">
    <!-- PWA Manifest & App Icons -->
    <link rel="manifest" href="/manifest.json">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">
    <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192.png">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Store Control">
    <meta name="application-name" content="Store Control">
</head>
<body class="h-full flex flex-col font-sans text-slate-800 antialiased selection:bg-brand-500 selection:text-white pb-16 md:pb-0">

    <!-- Top Navigation Header -->
    <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 gap-2">
                
                <!-- Logo & Brand -->
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-slate-950 font-bold shadow-md shadow-emerald-500/20 flex-shrink-0">
                        <i data-lucide="store" class="w-5 h-5 sm:w-6 sm:h-6 text-slate-900"></i>
                    </div>
                    <div>
                        <span class="text-base sm:text-lg font-black tracking-tight text-white flex items-center gap-1.5">
                            Store<span class="text-emerald-400">Control</span>
                            <span class="text-[9px] sm:text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-slate-800 text-emerald-400 border border-emerald-500/20">Pro 2.0</span>
                        </span>
                        <p class="text-[11px] text-slate-400 hidden lg:block">Zentraler geräteübergreifender Laden-, Umsatz- & Kostenmanager</p>
                    </div>
                </div>

                <!-- Global Filters & Sync / Account Controls -->
                <div class="flex items-center gap-2 sm:gap-3">
                    
                    <!-- Sync Status Pill -->
                    <button id="syncStatusBtn" onclick="triggerManualSync()" title="Klicken für manuelle Synchronisation" class="flex items-center gap-1.5 px-2 sm:px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-800 text-emerald-400 border border-emerald-500/30 hover:bg-slate-700/80 transition cursor-pointer">
                        <span id="syncIndicatorDot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="syncStatusText" class="text-[11px] sm:text-xs">Live-Sync</span>
                    </button>

                    <!-- PWA Mobile Install Button -->
                    <button id="pwaInstallHeaderBtn" onclick="handlePwaInstallClick()" title="Store Control als App auf Smartphone installieren" class="hidden flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white px-2.5 py-1.5 rounded-lg text-xs font-bold shadow-md transition">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span class="text-[11px] sm:text-xs">App installieren</span>
                    </button>

                    <!-- Smartphone Connect QR Button -->
                    <button onclick="openModal('qrModal')" title="Smartphone per QR-Code verbinden" class="flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-slate-700 transition">
                        <i data-lucide="smartphone" class="w-4 h-4 text-emerald-400"></i>
                        <span class="hidden md:inline">Smartphone</span>
                    </button>

                    <!-- User Account / Role Menu -->
                    <button id="userMenuBtn" onclick="openModal('loginModal')" title="Benutzerkonto verwalten" class="flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-slate-700 transition">
                        <i data-lucide="user-check" class="w-4 h-4 text-brand-400"></i>
                        <span id="navUsername" class="hidden sm:inline">Admin</span>
                    </button>

                    <!-- Store Selector Dropdown -->
                    <div class="flex items-center gap-1 sm:gap-2 bg-slate-800/90 px-2 sm:px-3 py-1.5 rounded-lg border border-slate-700">
                        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0"></i>
                        <select id="globalStoreSelect" class="bg-transparent text-xs sm:text-sm font-medium text-white focus:outline-none cursor-pointer max-w-[110px] sm:max-w-none">
                            <option value="ALL" class="bg-slate-900 text-white">⭐ Alle Filialen</option>
                        </select>
                    </div>

                    <!-- Month Selector -->
                    <div class="flex items-center gap-1.5 bg-slate-800/90 px-2 sm:px-3 py-1.5 rounded-lg border border-slate-700 hidden sm:flex">
                        <i data-lucide="calendar" class="w-3.5 h-3.5 text-brand-400 flex-shrink-0"></i>
                        <input type="month" id="globalMonthSelect" class="bg-transparent text-xs sm:text-sm font-medium text-white focus:outline-none cursor-pointer">
                    </div>

                    <!-- Quick Action Buttons (Desktop) -->
                    <button onclick="openModal('quickRevenueModal')" class="hidden md:flex items-center gap-1.5 bg-emerald-500 hover:bg-emerald-600 text-slate-950 px-3 py-1.5 rounded-lg font-bold text-xs sm:text-sm shadow-md shadow-emerald-500/25 transition">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        <span>+ Umsatz</span>
                    </button>
                    <button onclick="openModal('quickExpenseModal')" class="hidden md:flex items-center gap-1.5 bg-rose-500 hover:bg-rose-600 text-white px-3 py-1.5 rounded-lg font-bold text-xs sm:text-sm shadow-md shadow-rose-500/25 transition">
                        <i data-lucide="minus-circle" class="w-4 h-4"></i>
                        <span>+ Kosten</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs (Desktop & Tablet) -->
    <div class="bg-white border-b border-slate-200 shadow-sm sticky top-16 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="flex space-x-1 sm:space-x-3 overflow-x-auto py-2 scrollbar-none" id="mainNav">
                <button onclick="switchTab('dashboard')" class="nav-tab active-tab flex items-center gap-2 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition whitespace-nowrap">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                    <span>Übersicht & KPIs</span>
                </button>
                <button onclick="switchTab('revenues')" class="nav-tab flex items-center gap-2 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition whitespace-nowrap">
                    <i data-lucide="trending-up" class="w-4 h-4 text-emerald-600"></i>
                    <span>Tagesumsätze</span>
                </button>
                <button onclick="switchTab('expenses')" class="nav-tab flex items-center gap-2 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition whitespace-nowrap">
                    <i data-lucide="receipt" class="w-4 h-4 text-rose-500"></i>
                    <span>Kosten & Ausgaben</span>
                </button>
                <button onclick="switchTab('products')" class="nav-tab flex items-center gap-2 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition whitespace-nowrap">
                    <i data-lucide="package" class="w-4 h-4 text-teal-600"></i>
                    <span>Artikel & Lager</span>
                </button>
                <button onclick="switchTab('monthlyReport')" class="nav-tab flex items-center gap-2 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition whitespace-nowrap">
                    <i data-lucide="pie-chart" class="w-4 h-4 text-brand-600"></i>
                    <span>Monatsanalyse & GuV</span>
                </button>
                <button onclick="switchTab('stores')" class="nav-tab flex items-center gap-2 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition whitespace-nowrap">
                    <i data-lucide="building-2" class="w-4 h-4 text-purple-600"></i>
                    <span>Filialen verwalten</span>
                </button>
                <button onclick="switchTab('auditLogs')" class="nav-tab flex items-center gap-2 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition whitespace-nowrap">
                    <i data-lucide="shield-check" class="w-4 h-4 text-indigo-600"></i>
                    <span>Revisions-Log</span>
                </button>
                <button onclick="switchTab('settings')" class="nav-tab flex items-center gap-2 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition whitespace-nowrap">
                    <i data-lucide="settings" class="w-4 h-4 text-amber-600"></i>
                    <span>Export & Setup</span>
                </button>
            </nav>
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-6">

        <!-- Optional Migration Notice Banner -->
        <div id="migrationBanner" class="hidden bg-amber-500/15 border border-amber-500/30 text-amber-950 p-4 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-sm animate-scaleIn">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-bold flex-shrink-0">
                    <i data-lucide="database" class="w-4 h-4"></i>
                </div>
                <div>
                    <h4 class="font-bold text-sm">Bestehende Browser-Daten gefunden</h4>
                    <p class="text-xs text-amber-800">Möchten Sie Ihre bisher lokal im Browser gespeicherten Filialen, Umsätze und Kosten in die zentrale Server-Datenbank übertragen?</p>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button onclick="runLocalStorageMigration()" class="flex-1 sm:flex-none px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl shadow transition">
                    Jetzt in Datenbank übertragen
                </button>
                <button onclick="dismissMigrationBanner()" class="px-3 py-2 bg-amber-200/50 hover:bg-amber-200 text-amber-900 text-xs font-semibold rounded-xl transition">
                    Später
                </button>
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- TAB 1: DASHBOARD & KPIS                                                  -->
        <!-- ========================================================================= -->
        <section id="tab-dashboard" class="tab-content block space-y-6">
            
            <!-- Quick Actions Mobile Bar -->
            <div class="grid grid-cols-3 gap-2 md:hidden">
                <button onclick="openQuickNumpad()" class="flex flex-col items-center justify-center gap-1 bg-gradient-to-tr from-emerald-600 to-teal-500 text-white py-2.5 px-2 rounded-xl font-bold text-xs shadow active:scale-95 transition">
                    <i data-lucide="calculator" class="w-5 h-5"></i>
                    <span>⚡ Blitz-Buchung</span>
                </button>
                <button onclick="openModal('quickRevenueModal')" class="flex flex-col items-center justify-center gap-1 bg-emerald-700 text-white py-2.5 px-2 rounded-xl font-bold text-xs shadow active:scale-95 transition">
                    <i data-lucide="plus" class="w-5 h-5"></i>
                    <span>Umsatz</span>
                </button>
                <button onclick="openModal('quickExpenseModal')" class="flex flex-col items-center justify-center gap-1 bg-rose-600 text-white py-2.5 px-2 rounded-xl font-bold text-xs shadow active:scale-95 transition">
                    <i data-lucide="minus" class="w-5 h-5"></i>
                    <span>Kosten</span>
                </button>
            </div>

            <!-- Banner / Context Notice -->
            <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 rounded-2xl p-5 sm:p-6 text-white shadow-lg border border-slate-700/50 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2 text-xs font-semibold text-emerald-400 uppercase tracking-wider">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="bannerActiveFilterText">Alle Filialen | Aktueller Monat</span>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-black tracking-tight" id="bannerTitle">Zentrales Umsatz-Cockpit</h2>
                    <p class="text-xs text-slate-300">Alle Daten werden zentral gespeichert und synchron zwischen Desktop-PC & Smartphone aktualisiert.</p>
                </div>
                <div class="flex items-center gap-2 w-full md:w-auto">
                    <button onclick="openQuickNumpad()" class="hidden md:flex items-center gap-2 bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 px-4 py-2 rounded-xl font-bold text-xs shadow transition">
                        <i data-lucide="calculator" class="w-4 h-4"></i>
                        <span>⚡ Touch-Schnellbuchung (Numpad)</span>
                    </button>
                    <button onclick="openBarcodeScanner()" class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3.5 py-2 rounded-xl font-bold text-xs transition">
                        <i data-lucide="scan-barcode" class="w-4 h-4 text-emerald-400"></i>
                        <span>Barcode scannen</span>
                    </button>
                </div>
            </div>

            <!-- Top 4 KPI Cards -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                <!-- KPI 1: Umsatz Heute -->
                <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition">
                    <div class="flex items-center justify-between mb-2 sm:mb-3">
                        <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-slate-500">Umsatz Heute</span>
                        <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
                            <i data-lucide="trending-up" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div class="text-xl sm:text-3xl font-black text-slate-900" id="kpiTodayRevenue">0,00 €</div>
                    <div class="text-[10px] sm:text-xs text-slate-500 mt-1 flex items-center gap-1.5" id="kpiTodaySubtext">
                        <i data-lucide="calendar" class="w-3.5 h-3.5"></i> <span id="kpiTodayDate">Heute</span>
                    </div>
                    <div class="mt-2 sm:mt-3 pt-2 sm:pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-600">
                        <span>Bar: <strong id="kpiTodayCash">0,00 €</strong></span>
                        <span>Karte: <strong id="kpiTodayCard">0,00 €</strong></span>
                    </div>
                </div>

                <!-- KPI 2: Monatsumsatz -->
                <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition">
                    <div class="flex items-center justify-between mb-2 sm:mb-3">
                        <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-slate-500">Monatsumsatz</span>
                        <div class="w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">
                            <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div class="text-xl sm:text-3xl font-black text-slate-900" id="kpiMonthRevenue">0,00 €</div>
                    <div class="text-[10px] sm:text-xs text-emerald-600 font-semibold mt-1 flex items-center gap-1" id="kpiMonthEntryCount">
                        <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> <span>0 Buchungen</span>
                    </div>
                    <div class="mt-2 sm:mt-3 pt-2 sm:pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-600">
                        <span>Ø Tag:</span>
                        <strong id="kpiAvgDailyRevenue">0,00 €</strong>
                    </div>
                </div>

                <!-- KPI 3: Monatskosten -->
                <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition">
                    <div class="flex items-center justify-between mb-2 sm:mb-3">
                        <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-slate-500">Gesamtkosten</span>
                        <div class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold">
                            <i data-lucide="receipt" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div class="text-xl sm:text-3xl font-black text-rose-600" id="kpiMonthCosts">0,00 €</div>
                    <div class="text-[10px] sm:text-xs text-slate-500 mt-1 flex items-center justify-between">
                        <span>Kostenquote:</span>
                        <strong id="kpiCostRatio" class="text-slate-700">0%</strong>
                    </div>
                    <div class="mt-2 sm:mt-3 pt-2 sm:pt-3 border-t border-slate-100 grid grid-cols-3 text-center text-[10px] text-slate-500">
                        <div>Pers: <b id="kpiStaffShort">0€</b></div>
                        <div>Miete: <b id="kpiRentShort">0€</b></div>
                        <div>Ware: <b id="kpiGoodsShort">0€</b></div>
                    </div>
                </div>

                <!-- KPI 4: Reingewinn -->
                <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition" id="kpiProfitCard">
                    <div class="flex items-center justify-between mb-2 sm:mb-3">
                        <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-slate-500">Reingewinn (Netto)</span>
                        <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold" id="kpiProfitIcon">
                            <i data-lucide="badge-percent" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div class="text-xl sm:text-3xl font-black text-emerald-600" id="kpiMonthProfit">0,00 €</div>
                    <div class="text-[10px] sm:text-xs text-slate-500 mt-1 flex items-center justify-between">
                        <span>Gewinnmarge:</span>
                        <strong id="kpiProfitMargin" class="text-emerald-700 font-bold">0%</strong>
                    </div>
                    <div class="mt-2 sm:mt-3 pt-2 sm:pt-3 border-t border-slate-100 flex items-center justify-between text-[11px]">
                        <span class="text-slate-500">Status:</span>
                        <span id="kpiProfitBadge" class="font-bold px-2 py-0.5 rounded-full text-[11px] bg-emerald-100 text-emerald-800">Gewinnzone</span>
                    </div>
                </div>
            </div>

            <!-- Charts Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Trend Line Chart -->
                <div class="bg-white p-4 sm:p-6 rounded-2xl border border-slate-200/80 shadow-sm lg:col-span-2 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div>
                            <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                                <i data-lucide="line-chart" class="w-4 h-4 text-emerald-500"></i>
                                Tagesumsatz- & Kostenverlauf
                            </h3>
                            <p class="text-xs text-slate-500">Entwicklung über alle Tage des ausgewählten Monats</p>
                        </div>
                    </div>
                    <div class="h-64 sm:h-72 w-full">
                        <canvas id="monthlyTrendChart"></canvas>
                    </div>
                </div>

                <!-- Cost Donut Chart -->
                <div class="bg-white p-4 sm:p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                    <div>
                        <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                            <i data-lucide="pie-chart" class="w-4 h-4 text-rose-500"></i>
                            Kostenverteilung
                        </h3>
                        <p class="text-xs text-slate-500">Aufteilung der Filialkosten im Monat</p>
                    </div>
                    <div class="h-48 sm:h-52 relative flex items-center justify-center">
                        <canvas id="costBreakdownChart"></canvas>
                    </div>
                    <div class="text-xs space-y-1.5 pt-2 border-t border-slate-100">
                        <div class="flex items-center justify-between">
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> Mitarbeiter:</span>
                            <strong id="legendStaff">0,00 €</strong>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Miete & Nebenkosten:</span>
                            <strong id="legendRent">0,00 €</strong>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Wareneinsatz:</span>
                            <strong id="legendGoods">0,00 €</strong>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span> Sonstige Kosten:</span>
                            <strong id="legendOther">0,00 €</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Store Comparison Table -->
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-4 sm:p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                            <i data-lucide="building-2" class="w-4 h-4 text-purple-600"></i>
                            Filial-Vergleich im aktuellen Monat
                        </h3>
                        <p class="text-xs text-slate-500">Gegenüberstellung aller Läden: Umsatz, Kosten und Nettoergebnis</p>
                    </div>
                    <button onclick="switchTab('stores')" class="text-xs font-bold text-purple-600 hover:text-purple-700 flex items-center gap-1">
